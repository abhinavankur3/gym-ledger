# Admin credentials (used to create the initial admin user)
ADMIN_EMAIL=admin@gym.local
ADMIN_PASSWORD=changeme

# Session secret (generate a random 32+ char string)
# openssl rand -base64 32
SESSION_SECRET=

# Database path
DATABASE_URL=file:./data/gym-ledger.db

# Optional AI plan generation and candidate scoring
OPENROUTER_API_KEY=
OPENROUTER_GENERATION_MODEL=qwen/qwen3-32b
OPENROUTER_DECISION_MODEL=typesafe/jev-1.13
APP_URL=http://localhost:3000
